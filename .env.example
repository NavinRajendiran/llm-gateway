# ===========================================
# Free LLM Gateway - Environment Variables
# ===========================================

# Gateway auth key (clients use this as OPENAI_API_KEY)
GATEWAY_API_KEY=sk-your-secret-gateway-key

# -------------------------------------------------
# Recommended (highest priority / most reliable)
# -------------------------------------------------
GROQ_API_KEY=                    # https://console.groq.com/keys
GEMINI_API_KEY=                  # https://aistudio.google.com/app/apikey
OPENROUTER_API_KEY=              # https://openrouter.ai/keys

# -------------------------------------------------
# Strong free tiers
# -------------------------------------------------
SILICONFLOW_API_KEY=             # https://cloud.siliconflow.cn/
NVIDIA_API_KEY=                  # https://build.nvidia.com/
CLOUDFLARE_API_TOKEN=            # https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=           # from Cloudflare dashboard URL

# -------------------------------------------------
# Provider APIs
# -------------------------------------------------
AION_API_KEY=                    # https://www.aionlabs.ai/app/api-keys/
ZAI_API_KEY=                     # https://open.bigmodel.cn/usercenter/apikeys
COHERE_API_KEY=                  # https://dashboard.cohere.com/api-keys  (non-commercial)

# -------------------------------------------------
# Other free / generous
# -------------------------------------------------
MODELSCOPE_API_KEY=              # https://modelscope.cn/my/myaccesstoken
GONKA_API_KEY=                   # https://app.gonkabroker.com/
LLM7_TOKEN=                      # https://token.llm7.io  (optional)
KILO_API_KEY=                    # usually not needed for free pool
OVH_API_KEY=                     # optional, anonymous tier exists
